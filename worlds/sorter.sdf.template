<?xml version="1.0" ?>
<sdf version="1.8">
  <!-- Multi-Color Robotic Sorter Workcell with 4-DOF Robot & Electromagnet
       Features:
         - Industrial work table with high-friction top surface
         - Dedicated left and right side sorting bays for Red, Yellow, Green, and Blue
         - Overhead camera (Z=2.5m) and 3D isometric perspective camera
         - Procedurally inserted dynamic workpiece blocks
         - 4-DOF manipulator with JointPositionControllers & DetachableJoint plugins -->
  <world name="sorter">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>

    <scene>
      <ambient>0.9 0.9 0.9</ambient>
      <background>0.7 0.7 0.7</background>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Work table: surface at z = 0.45 with sturdy legs -->
    <model name="table">
      <static>true</static>
      <pose>0 0 0.4 0 0 0</pose>
      <link name="top">
        <collision name="collision">
          <geometry><box><size>2.0 1.5 0.1</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 1.5 0.1</size></box></geometry>
          <material><ambient>0.52 0.38 0.24 1</ambient><diffuse>0.55 0.40 0.25 1</diffuse></material>
        </visual>
        <!-- Table Legs -->
        <visual name="leg1"><pose>0.88 -0.63 -0.20 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.40</length></cylinder></geometry><material><ambient>0.2 0.22 0.25 1</ambient><diffuse>0.25 0.26 0.28 1</diffuse></material></visual>
        <visual name="leg2"><pose>-0.88 -0.63 -0.20 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.40</length></cylinder></geometry><material><ambient>0.2 0.22 0.25 1</ambient><diffuse>0.25 0.26 0.28 1</diffuse></material></visual>
        <visual name="leg3"><pose>0.88 0.63 -0.20 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.40</length></cylinder></geometry><material><ambient>0.2 0.22 0.25 1</ambient><diffuse>0.25 0.26 0.28 1</diffuse></material></visual>
        <visual name="leg4"><pose>-0.88 0.63 -0.20 0 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.40</length></cylinder></geometry><material><ambient>0.2 0.22 0.25 1</ambient><diffuse>0.25 0.26 0.28 1</diffuse></material></visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- SIDE SORTING BINS: 0.46 x 0.26 m trays, 3 block slots each (see workcell.py) -->
    <!-- =================================================================== -->

    <!-- Left Side Bay - Slot 1: RED BIN (X=-0.58, Y=-0.14) -->
    <model name="red_bin">
      <static>true</static>
      <pose>-0.58 -0.14 0.452 0 0 0</pose>
      <link name="link">
        <collision name="floor_col">
          <pose>0 0 0.004 0 0 0</pose>
          <geometry><box><size>0.46 0.26 0.008</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <collision name="wall_n"><pose>0 0.125 0.02 0 0 0</pose><geometry><box><size>0.46 0.015 0.035</size></box></geometry></collision>
        <collision name="wall_s"><pose>0 -0.125 0.02 0 0 0</pose><geometry><box><size>0.46 0.015 0.035</size></box></geometry></collision>
        <collision name="wall_w"><pose>-0.2225 0 0.02 0 0 0</pose><geometry><box><size>0.015 0.235 0.035</size></box></geometry></collision>
        <collision name="wall_e"><pose>0.2225 0 0.02 0 0 0</pose><geometry><box><size>0.015 0.235 0.035</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.46 0.26 0.008</size></box></geometry>
          <material><ambient>0.9 0.1 0.1 0.9</ambient><diffuse>0.9 0.1 0.1 0.9</diffuse></material>
        </visual>
        <visual name="rim_n"><pose>0 0.125 0.02 0 0 0</pose><geometry><box><size>0.46 0.015 0.035</size></box></geometry><material><ambient>0.65 0.1 0.1 1</ambient><diffuse>0.65 0.1 0.1 1</diffuse></material></visual>
        <visual name="rim_s"><pose>0 -0.125 0.02 0 0 0</pose><geometry><box><size>0.46 0.015 0.035</size></box></geometry><material><ambient>0.65 0.1 0.1 1</ambient><diffuse>0.65 0.1 0.1 1</diffuse></material></visual>
        <visual name="rim_w"><pose>-0.2225 0 0.02 0 0 0</pose><geometry><box><size>0.015 0.235 0.035</size></box></geometry><material><ambient>0.65 0.1 0.1 1</ambient><diffuse>0.65 0.1 0.1 1</diffuse></material></visual>
        <visual name="rim_e"><pose>0.2225 0 0.02 0 0 0</pose><geometry><box><size>0.015 0.235 0.035</size></box></geometry><material><ambient>0.65 0.1 0.1 1</ambient><diffuse>0.65 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Left Side Bay - Slot 2: YELLOW BIN (X=-0.58, Y=-0.42) -->
    <model name="yellow_bin">
      <static>true</static>
      <pose>-0.58 -0.42 0.452 0 0 0</pose>
      <link name="link">
        <collision name="floor_col">
          <pose>0 0 0.004 0 0 0</pose>
          <geometry><box><size>0.46 0.26 0.008</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <collision name="wall_n"><pose>0 0.125 0.02 0 0 0</pose><geometry><box><size>0.46 0.015 0.035</size></box></geometry></collision>
        <collision name="wall_s"><pose>0 -0.125 0.02 0 0 0</pose><geometry><box><size>0.46 0.015 0.035</size></box></geometry></collision>
        <collision name="wall_w"><pose>-0.2225 0 0.02 0 0 0</pose><geometry><box><size>0.015 0.235 0.035</size></box></geometry></collision>
        <collision name="wall_e"><pose>0.2225 0 0.02 0 0 0</pose><geometry><box><size>0.015 0.235 0.035</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.46 0.26 0.008</size></box></geometry>
          <material><ambient>0.9 0.8 0.05 0.9</ambient><diffuse>0.9 0.8 0.05 0.9</diffuse></material>
        </visual>
        <visual name="rim_n"><pose>0 0.125 0.02 0 0 0</pose><geometry><box><size>0.46 0.015 0.035</size></box></geometry><material><ambient>0.7 0.6 0.05 1</ambient><diffuse>0.7 0.6 0.05 1</diffuse></material></visual>
        <visual name="rim_s"><pose>0 -0.125 0.02 0 0 0</pose><geometry><box><size>0.46 0.015 0.035</size></box></geometry><material><ambient>0.7 0.6 0.05 1</ambient><diffuse>0.7 0.6 0.05 1</diffuse></material></visual>
        <visual name="rim_w"><pose>-0.2225 0 0.02 0 0 0</pose><geometry><box><size>0.015 0.235 0.035</size></box></geometry><material><ambient>0.7 0.6 0.05 1</ambient><diffuse>0.7 0.6 0.05 1</diffuse></material></visual>
        <visual name="rim_e"><pose>0.2225 0 0.02 0 0 0</pose><geometry><box><size>0.015 0.235 0.035</size></box></geometry><material><ambient>0.7 0.6 0.05 1</ambient><diffuse>0.7 0.6 0.05 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Right Side Bay - Slot 3: GREEN BIN (X=+0.58, Y=-0.14) -->
    <model name="green_bin">
      <static>true</static>
      <pose>0.58 -0.14 0.452 0 0 0</pose>
      <link name="link">
        <collision name="floor_col">
          <pose>0 0 0.004 0 0 0</pose>
          <geometry><box><size>0.46 0.26 0.008</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <collision name="wall_n"><pose>0 0.125 0.02 0 0 0</pose><geometry><box><size>0.46 0.015 0.035</size></box></geometry></collision>
        <collision name="wall_s"><pose>0 -0.125 0.02 0 0 0</pose><geometry><box><size>0.46 0.015 0.035</size></box></geometry></collision>
        <collision name="wall_w"><pose>-0.2225 0 0.02 0 0 0</pose><geometry><box><size>0.015 0.235 0.035</size></box></geometry></collision>
        <collision name="wall_e"><pose>0.2225 0 0.02 0 0 0</pose><geometry><box><size>0.015 0.235 0.035</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.46 0.26 0.008</size></box></geometry>
          <material><ambient>0.1 0.8 0.1 0.9</ambient><diffuse>0.1 0.8 0.1 0.9</diffuse></material>
        </visual>
        <visual name="rim_n"><pose>0 0.125 0.02 0 0 0</pose><geometry><box><size>0.46 0.015 0.035</size></box></geometry><material><ambient>0.08 0.6 0.1 1</ambient><diffuse>0.08 0.6 0.1 1</diffuse></material></visual>
        <visual name="rim_s"><pose>0 -0.125 0.02 0 0 0</pose><geometry><box><size>0.46 0.015 0.035</size></box></geometry><material><ambient>0.08 0.6 0.1 1</ambient><diffuse>0.08 0.6 0.1 1</diffuse></material></visual>
        <visual name="rim_w"><pose>-0.2225 0 0.02 0 0 0</pose><geometry><box><size>0.015 0.235 0.035</size></box></geometry><material><ambient>0.08 0.6 0.1 1</ambient><diffuse>0.08 0.6 0.1 1</diffuse></material></visual>
        <visual name="rim_e"><pose>0.2225 0 0.02 0 0 0</pose><geometry><box><size>0.015 0.235 0.035</size></box></geometry><material><ambient>0.08 0.6 0.1 1</ambient><diffuse>0.08 0.6 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Right Side Bay - Slot 4: BLUE BIN (X=+0.58, Y=-0.42) -->
    <model name="blue_bin">
      <static>true</static>
      <pose>0.58 -0.42 0.452 0 0 0</pose>
      <link name="link">
        <collision name="floor_col">
          <pose>0 0 0.004 0 0 0</pose>
          <geometry><box><size>0.46 0.26 0.008</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <collision name="wall_n"><pose>0 0.125 0.02 0 0 0</pose><geometry><box><size>0.46 0.015 0.035</size></box></geometry></collision>
        <collision name="wall_s"><pose>0 -0.125 0.02 0 0 0</pose><geometry><box><size>0.46 0.015 0.035</size></box></geometry></collision>
        <collision name="wall_w"><pose>-0.2225 0 0.02 0 0 0</pose><geometry><box><size>0.015 0.235 0.035</size></box></geometry></collision>
        <collision name="wall_e"><pose>0.2225 0 0.02 0 0 0</pose><geometry><box><size>0.015 0.235 0.035</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.46 0.26 0.008</size></box></geometry>
          <material><ambient>0.1 0.3 0.9 0.9</ambient><diffuse>0.1 0.3 0.9 0.9</diffuse></material>
        </visual>
        <visual name="rim_n"><pose>0 0.125 0.02 0 0 0</pose><geometry><box><size>0.46 0.015 0.035</size></box></geometry><material><ambient>0.1 0.22 0.7 1</ambient><diffuse>0.1 0.22 0.7 1</diffuse></material></visual>
        <visual name="rim_s"><pose>0 -0.125 0.02 0 0 0</pose><geometry><box><size>0.46 0.015 0.035</size></box></geometry><material><ambient>0.1 0.22 0.7 1</ambient><diffuse>0.1 0.22 0.7 1</diffuse></material></visual>
        <visual name="rim_w"><pose>-0.2225 0 0.02 0 0 0</pose><geometry><box><size>0.015 0.235 0.035</size></box></geometry><material><ambient>0.1 0.22 0.7 1</ambient><diffuse>0.1 0.22 0.7 1</diffuse></material></visual>
        <visual name="rim_e"><pose>0.2225 0 0.02 0 0 0</pose><geometry><box><size>0.015 0.235 0.035</size></box></geometry><material><ambient>0.1 0.22 0.7 1</ambient><diffuse>0.1 0.22 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- DYNAMIC PROCEDURAL WORKPIECE BLOCKS                                 -->
    <!-- =================================================================== -->
<!-- @INSERT_WORKPIECE_BLOCKS@ -->

    <!-- Overhead camera, 2.5 m above table centre (oriented: left=-X, right=+X, bottom=-Y, top=+Y) -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>0 0 2.5 0 1.5707963 1.5707963</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.000166667</ixx><iyy>0.000166667</iyy><izz>0.000166667</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
        </visual>
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>0.9</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.1</near><far>10</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>15</update_rate>
          <visualize>true</visualize>
          <topic>/camera/image_raw</topic>
        </sensor>
      </link>
    </model>

    <!-- 3D Isometric Perspective Camera for rich 3D visualization -->
    <model name="perspective_camera">
      <static>true</static>
      <pose>1.1 -1.4 1.35 0 0.49 2.33</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.08</size></box></geometry>
          <material><ambient>0.2 0.2 0.25 1</ambient><diffuse>0.2 0.2 0.25 1</diffuse></material>
        </visual>
        <sensor name="perspective_camera" type="camera">
          <camera>
            <horizontal_fov>1.1</horizontal_fov>
            <image><width>800</width><height>600</height></image>
            <clip><near>0.1</near><far>15</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>15</update_rate>
          <visualize>true</visualize>
          <topic>/camera/perspective/image_raw</topic>
        </sensor>
      </link>
    </model>

    <!-- Front-Facing Eye-Level Camera (looking across worktable towards robot) -->
    <model name="front_camera">
      <static>true</static>
      <pose>0.0 1.25 0.90 0 0.35 -1.5707963</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.08</size></box></geometry>
          <material><ambient>0.2 0.2 0.25 1</ambient><diffuse>0.2 0.2 0.25 1</diffuse></material>
        </visual>
        <sensor name="front_camera" type="camera">
          <camera>
            <horizontal_fov>1.15</horizontal_fov>
            <image><width>800</width><height>600</height></image>
            <clip><near>0.1</near><far>15</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>15</update_rate>
          <visualize>true</visualize>
          <topic>/camera/front/image_raw</topic>
        </sensor>
      </link>
    </model>

    <!-- 4-DOF Articulated Robot with Electromagnet End-Effector -->
    <model name="sorter_robot">
      <pose>0 -0.55 0.45 0 0 0</pose>

      <!-- Base Pedestal (fixed to table) -->
      <link name="base_link">
        <inertial>
          <mass>10.0</mass>
          <inertia><ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.1</iyy><iyz>0</iyz><izz>0.1</izz></inertia>
        </inertial>
        <visual name="pedestal_vis">
          <pose>0 0 0.075 0 0 0</pose>
          <geometry><cylinder><radius>0.11</radius><length>0.15</length></cylinder></geometry>
          <material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.15 0.15 0.18 1</diffuse></material>
        </visual>
        <collision name="pedestal_col">
          <pose>0 0 0.075 0 0 0</pose>
          <geometry><cylinder><radius>0.11</radius><length>0.15</length></cylinder></geometry>
        </collision>
      </link>

      <joint name="world_fixed" type="fixed">
        <parent>world</parent>
        <child>base_link</child>
      </joint>

      <!-- Shoulder Turret (Joint 1: Yaw about Z) -->
      <link name="shoulder_link">
        <pose>0 0 0.15 0 0 0</pose>
        <inertial>
          <mass>2.0</mass>
          <inertia><ixx>0.008</ixx><iyy>0.008</iyy><izz>0.008</izz></inertia>
        </inertial>
        <visual name="shoulder_vis">
          <pose>0 0 0.025 0 0 0</pose>
          <geometry><cylinder><radius>0.085</radius><length>0.09</length></cylinder></geometry>
          <material><ambient>0.4 0.4 0.45 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>

      <joint name="joint_1" type="revolute">
        <parent>base_link</parent>
        <child>shoulder_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-3.14159</lower><upper>3.14159</upper><effort>100</effort><velocity>3.0</velocity></limit>
          <dynamics><damping>1.0</damping></dynamics>
        </axis>
      </joint>

      <!-- Upper Arm (Joint 2: Pitch about Y, L2 = 0.45m) -->
      <link name="upper_arm_link">
        <pose>0 0 0.20 0 0 0</pose>
        <inertial>
          <pose>0 0 0.225 0 0 0</pose>
          <mass>1.5</mass>
          <inertia><ixx>0.026</ixx><iyy>0.026</iyy><izz>0.002</izz></inertia>
        </inertial>
        <visual name="upper_arm_vis">
          <pose>0 0 0.225 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>0.45</length></cylinder></geometry>
          <material><ambient>0.85 0.45 0.05 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
        </visual>
      </link>

      <joint name="joint_2" type="revolute">
        <pose>0 0 0 0 0 0</pose>
        <parent>shoulder_link</parent>
        <child>upper_arm_link</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-1.57</lower><upper>3.14</upper><effort>300</effort><velocity>2.5</velocity></limit>
          <dynamics><damping>2.0</damping></dynamics>
        </axis>
      </joint>

      <!-- Forearm (Joint 3: Pitch about Y, L3 = 0.42m) -->
      <link name="forearm_link">
        <pose>0 0 0.65 0 0 0</pose>
        <inertial>
          <pose>0 0 0.21 0 0 0</pose>
          <mass>1.0</mass>
          <inertia><ixx>0.015</ixx><iyy>0.015</iyy><izz>0.001</izz></inertia>
        </inertial>
        <visual name="forearm_vis">
          <pose>0 0 0.21 0 0 0</pose>
          <geometry><cylinder><radius>0.035</radius><length>0.42</length></cylinder></geometry>
          <material><ambient>0.4 0.4 0.45 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>

      <joint name="joint_3" type="revolute">
        <pose>0 0 0 0 0 0</pose>
        <parent>upper_arm_link</parent>
        <child>forearm_link</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-3.14</lower><upper>3.14</upper><effort>200</effort><velocity>2.5</velocity></limit>
          <dynamics><damping>1.5</damping></dynamics>
        </axis>
      </joint>

      <!-- Wrist & Electromagnet (Joint 4: Pitch about Y, L4 = 0.12m) -->
      <link name="electromagnet_link">
        <pose>0 0 1.07 0 0 0</pose>
        <inertial>
          <pose>0 0 0.06 0 0 0</pose>
          <mass>0.4</mass>
          <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.0005</izz></inertia>
        </inertial>
        <visual name="wrist_vis">
          <pose>0 0 0.04 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name="magnet_vis">
          <pose>0 0 0.10 0 0 0</pose>
          <geometry><cylinder><radius>0.045</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.15 0.15 0.18 1</diffuse></material>
        </visual>
      </link>

      <joint name="joint_4" type="revolute">
        <pose>0 0 0 0 0 0</pose>
        <parent>forearm_link</parent>
        <child>electromagnet_link</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-3.14</lower><upper>3.14</upper><effort>100</effort><velocity>3.0</velocity></limit>
          <dynamics><damping>0.5</damping></dynamics>
        </axis>
      </joint>

      <!-- Magnetic Tool Grasp Frame (0.12m magnet + 0.06m half-block = 0.18m from Joint 4) -->
      <link name="magnetic_tool_link">
        <pose>0 0 1.25 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
        </inertial>
      </link>

      <joint name="magnet_tool_joint" type="fixed">
        <parent>electromagnet_link</parent>
        <child>magnetic_tool_link</child>
